# large-v3-turbo is both more accurate and ~10x faster than large-v3 on CPU.
# Do not drop to `base`: it scores 23% where turbo scores 60% on Bosnian.
STT_MODEL=large-v3-turbo
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Priming. Worth ~2.6 points of accuracy; set either to an empty value to
# disable. Add names, jargon, or product names you dictate often to STT_HOTWORDS.
# STT_INITIAL_PROMPT=
# STT_HOTWORDS=GPT, API, Claude Code, browser tab, voice text, copy paste, chat

# Language for batch runs and the web page; the CLI's --language overrides it.
# Auto-detect is right for short mixed Bosnian/English speech, but it reads the
# first 30 seconds *after* VAD trimming, and on a 4m47s Bosnian voice note that
# came back as English at 37.9% confidence -- undetected, the same audio reads
# as Serbian at 63.9%. Whisper then decoded Bosnian as English, with the mess
# you would expect. Force "hr" for longer recordings, never "bs".
STT_LANGUAGE=auto

# Backend: "local" runs Whisper on this machine. "elevenlabs" is not built yet.
STT_BACKEND=local

# Dictation. Auto-detect is unreliable on short clips, so a language is forced.
# STT_DICTATE_MODEL defaults to STT_MODEL; set it to something smaller if you
# want dictation to answer faster than batch transcription.
STT_DICTATE_LANGUAGE=hr
# STT_DICTATE_MODEL=large-v3-turbo

# Web server defaults. Keep HOST=127.0.0.1 for desktop-only use.
# Set HOST=0.0.0.0 only when using the phone interface on your home Wi-Fi.
HOST=127.0.0.1
PORT=8765
MAX_UPLOAD_MB=100

# Local refinement (the "Pročisti" button). Requires `ollama serve` running.
#
# OLLAMA_NUM_CTX is not a tuning knob, it is a correctness setting. Ollama loads
# a model at its own default context rather than the model's maximum, and a
# prompt that does not fit is truncated to roughly half the window rather than
# refused -- no error, no warning, done_reason still "stop". Unset, qwen3:8b
# loads at CONTEXT 4096 and answers about a fifth of a long meeting while
# reporting success.
#
# Sizing it: Bosnian speech measured 1.95 tokens/word through qwen3's tokenizer,
# so ~270 tokens per minute of audio at a normal speaking rate, and the window
# holds the transcript plus the generated answer. 8192 covers roughly 20 minutes.
#
# The window costs VRAM, so it trades against the card. On 8 GB, measured:
#   qwen3:8b   4096 -> 5.6 GB   8192 -> 6.2 GB   16384 -> 7.8 GB, spills to CPU
#   gemma3:4b               32768 -> 2.9 GB, fully on GPU
# For hour-long recordings use the smaller model with the bigger window. Run
# `ollama ps` after changing either and check it still reports 100% GPU.
#
# Model load is 6.55s of a 7.21s cold call, so keep the model resident.
#
# Which model. Benchmarked 2026-09-02 on a Bosnian transcript whose auth-bug
# owner is named only in a Norwegian aside -- the kind of thing the refine and
# chat presets have to get right:
#   qwen3:8b      5.2 GB, 100% GPU, ~43 t/s. Named the wrong person, invented a
#                 task. The weakest reasoner that fits.
#   qwen3:14b     9.3 GB. Correct, invents nothing, best at "unify". Spills to
#                 CPU on an 8 GB card -> ~10 t/s, and thinking tasks take 1-2 min.
#   qwen3:30b-a3b-instruct-2507   18 GB, spills ~68% to CPU -- yet ~40 t/s,
#                 because only 3B is active per token (mixture of experts).
#                 30B-class reasoning at 8B speed; correct, no invention. Weak
#                 spot: "unify" (translate + merge). Needs ~13 GB free RAM for
#                 the spilled part. This is the default.
OLLAMA_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
# Fits fully in VRAM, fastest, weakest reasoner:
# OLLAMA_MODEL=qwen3:8b
# Hour-long meetings instead of quality on short notes (only model that holds
# 32k context on the GPU; least capable, quality not scored):
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_NUM_CTX=32768
# OLLAMA_URL=http://127.0.0.1:11434

# Halve the KV cache so a bigger model or window fits for the same VRAM. Set on
# the Ollama server (not here) and restart it:
#   OLLAMA_FLASH_ATTENTION=1
#   OLLAMA_KV_CACHE_TYPE=q8_0

# Where transcripts are kept. The web page used to hold everything in a browser
# variable, so a reload destroyed the recording and every refinement made from
# it. Defaults to %LOCALAPPDATA%\delaida-transcriber on Windows and
# ~/.local/share/delaida-transcriber elsewhere.
# STT_DATA_DIR=

# Whether the original audio is kept beside the transcript. Off deliberately:
# this project's premise is that recordings stay private, and quietly keeping
# every meeting's audio forever is a real change to what the tool does with your
# data. Transcripts are saved either way.
STT_KEEP_AUDIO=false

# Which model works ON the transcript. "ollama" runs here and is the default.
# "anthropic" sends the transcript to Anthropic -- transcription stays local
# either way, but this step would not. Needs: pip install -e ".[hosted]" and
# ANTHROPIC_API_KEY. The page says so on screen while it is in use.
#
# It exists because no single local model both reasons well and holds an
# hour-long meeting on an 8 GB card.
LLM_BACKEND=ollama
# ANTHROPIC_MODEL=claude-opus-5
