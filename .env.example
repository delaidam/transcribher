# Small and fast on CPU. Use small/medium/large-v3 if your hardware allows.
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# Web server defaults. Keep HOST=127.0.0.1 for desktop-only use.
# Set HOST=0.0.0.0 only when using the phone interface on your home Wi-Fi.
HOST=127.0.0.1
PORT=8765
MAX_UPLOAD_MB=100
